# Public frontend setting; set this in the GitHub Pages build environment.
VITE_API_BASE_URL=https://your-vercel-project.vercel.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Vercel environment variables. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ALLOWED_ORIGINS=http://localhost:5173,https://your-github-username.github.io

# Server-only survey API settings. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
