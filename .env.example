# Public frontend setting; set this in the GitHub Pages build environment.
VITE_API_BASE_URL=https://your-vercel-project.vercel.app

# Server-only Vercel environment variables. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ALLOWED_ORIGINS=http://localhost:5173,https://your-github-username.github.io
